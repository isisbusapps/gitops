logging {
	// The level at which alloy pods write their own logs
	level = "info"
}

remote.kubernetes.secret "loki_password" {
	name      = "loki-password"
	namespace = "alloy"
}

// discovery.kubernetes allows you to find scrape targets from Kubernetes resources.
// It watches cluster state and ensures targets are continually synced with what is currently running in your cluster.
// Filters here ensure we only scrape logs from pods in the apps namespace which don't have a bypass-alloy-scraper label.
discovery.kubernetes "lgtm_pods" {
	role = "pod"

	namespaces {
		names = ["lgtm"]
	}

	selectors {
		label = "!bypass-alloy-scraper"
		role  = "pod"
	}
}

// discovery.relabel rewrites the label set of the input targets by applying one or more relabeling rules.
// If no rules are defined, then the input targets are exported as-is.
discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.lgtm_pods.targets

	// Label creation - "namespace" field from "__meta_kubernetes_namespace"
	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		action        = "replace"
		target_label  = "namespace"
	}

	// Label creation - "pod" field from "__meta_kubernetes_pod_name"
	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		action        = "replace"
		target_label  = "pod"
	}

	// Label creation -  "service_name" field from "__meta_kubernetes_pod_label_app", the app commonLabel we add to our pods k8s config
	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		action        = "replace"
		target_label  = "service_name"
	}

	// Label creation -  "job" field from "__meta_kubernetes_namespace" and "__meta_kubernetes_pod_container_name"
	// Concatenate values __meta_kubernetes_namespace/__meta_kubernetes_pod_container_name
	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
		action        = "replace"
		target_label  = "job"
		separator     = "/"
		replacement   = "$1"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		action        = "replace"
		target_label  = "hostname"
	}
}

// loki.source.kubernetes tails logs from Kubernetes containers using the Kubernetes API.
loki.source.kubernetes "pod_logs" {
	targets    = discovery.relabel.pod_logs.output
	forward_to = [loki.process.pod_logs.receiver]
}

// loki.process receives log entries from other Loki components, applies one or more processing stages,
// and forwards the results to the list of receivers in the component's arguments.
loki.process "pod_logs" {

	stage.decolorize { }

	stage.multiline {
		firstline = "^\\[?[0-9]{4}-[0-9]{2}-[0-9]{2}"
		max_lines = 512
	}

	stage.regex {
		expression = "^\\[?(?P<time>[0-9]{4}-[0-9]{2}-[0-9]{2}[ T]\\d{1,2}:\\d{2}:\\d{2}[,.]\\d+[Z0-9:+-]*).*?(?P<level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL)"
	}

	stage.structured_metadata {
		values = {
			level = "level",
		}
	}

	// Drop TRACE logs from browserless
	stage.drop {
		expression = "browserless\\.io:server:trace"
	}

	forward_to = [loki.write.cluster.receiver]
}

loki.write "cluster" {
	endpoint {
		url = "https://loki.developers.facilities.rl.ac.uk/loki/api/v1/push"

		basic_auth {
			username = "fase"
			password = string.trim_space(convert.nonsensitive(remote.kubernetes.secret.loki_password.data["loki-password"]))
		}
		tenant_id = "FASE"
	}
}